<!-- 
This file allow for customizing your build process.
See: https://learn.microsoft.com/visualstudio/msbuild/customize-your-build
-->
<Project>
  <!--
  Uncomment if you need to enable inclusion of another Directory.Build.props file from a parent directory
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  -->

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 
    If you you like to see source generated files saved to disk you can enable the following:
    https://learn.microsoft.com/dotnet/csharp/roslyn-sdk/source-generators-overview?WT.mc_id=DT-MVP-5003472
    -->
    <!--<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
  </PropertyGroup>

  <!-- Sheaf.Web uses a .csproj to build and publish its TypeScript frontend, not C# sources. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(MSBuildProjectName)' != 'Sheaf.Web'">
    <PackageReference Include="DotNetWrangler.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <!--
  This allows all projects to share the same user secrets file. 
  If you want project to have their own, set it to a different value on each project.
  See: https://learn.microsoft.com/dotnet/architecture/microservices/secure-net-microservices-web-applications/developer-app-secrets-storage
  -->
  <!-- Tenancy-bypass APIs are banned in server production code; exemptions require reviewed RS0030 pragmas. -->
  <ItemGroup Label="Banned APIs" Condition="'$(MSBuildProjectName)' == 'Sheaf' Or '$(MSBuildProjectName)' == 'Sheaf.Core' Or '$(MSBuildProjectName)' == 'Sheaf.Data'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Label="User Secrets">
    <UserSecretsId>Sheaf-secrets</UserSecretsId>
  </PropertyGroup>

</Project>