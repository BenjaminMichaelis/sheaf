    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
