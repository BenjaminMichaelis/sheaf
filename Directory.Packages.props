    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Anthropic" Version="13.14.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
